<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.PetProductCollectMapper">

    <select id="getPetProductCollectList" parameterType="map" resultType="java.util.Map">
        select A.*, B.title, B.cover
        from pet_product_collect  A
        join pet_product  B on (A.product_id=B.id)
        where A.user_id=#{userId}
    </select>

</mapper>
